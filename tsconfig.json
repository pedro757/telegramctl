{
  "compilerOptions": {
    "noEmit": true,
    "noEmitOnError": true,
    "module": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["bin/**/*.ts", "src/**/*.ts", "scripts/**/*.ts"]
}
